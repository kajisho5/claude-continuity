{
  "name": "claude-continuity",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop app for importing Claude conversation exports and continuing them with the Anthropic API.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build && esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.js && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.js && npm run build:mcp",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "test": "vitest run",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --target=node18 --outfile=dist-mcp/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.seventhwell.claude-continuity",
    "productName": "Claude Continuity",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "dist-mcp/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kajisho5",
        "repo": "claude-continuity"
      }
    ],
    "asarUnpack": [
      "dist-mcp/**"
    ]
  }
}
